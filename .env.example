# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_RATE_LIMIT_RPM=15.0

# API Key (transferred via x-goog-api-key HTTP header, never in URL query string)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding and Reranker Models (Phase 2 Search Engine)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_MAX_SEQ_LENGTH=512
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60
RETRIEVAL_CANDIDATE_POOL=20
RERANKER_TOP_K=5

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TABLE_MAX_CHUNK_SIZE=3500

# Extraction Pipeline Settings
MAX_VALIDATION_RETRIES=2
CONFIDENCE_PASS_THRESHOLD=0.70
DOC_TYPE_CONFIDENCE_THRESHOLD=0.65

# API Server
API_HOST=0.0.0.0
API_PORT=8000

